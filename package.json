{
  "name": "konsey",
  "version": "1.3.0",
  "description": "Konsey: Claude, Codex, Gemini CLI and other coding agents working together on one project.",
  "main": "dist/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:ui": "esbuild ui/renderer.ts --bundle --outfile=dist/ui/renderer.js --platform=browser --format=iife --target=es2022",
    "copy:ui": "node scripts/copy-ui.js",
    "build": "npm run build:main && npm run copy:ui && npm run build:ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json",
    "test": "npm run build:main && node --test tests/*.test.js",
    "verify": "npm run typecheck && npm test && npm run build",
    "start": "npm run build && electron dist/electron/main.js",
    "cli": "npm run build:main && node dist/src/cli.js",
    "doctor": "npm run build:main && node dist/src/cli.js doctor",
    "icon": "python3 scripts/make-icon.py",
    "prepackage": "node scripts/check-app-not-running.js",
    "package": "npm run build && electron-builder --mac --arm64",
    "package:dir": "npm run build && electron-builder --mac dir --arm64",
    "ui": "npm run build && python3 -m http.server 8124 --directory dist/ui",
    "package:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.ardakie.konsey",
    "productName": "Konsey",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "Konsey-mac-${arch}.${ext}",
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0",
        "NSAppleEventsUsageDescription": "Konsey opens Terminal to install coding agents and to let you sign in to them.",
        "NSDesktopFolderUsageDescription": "Konsey and its agents work on project folders you pick on your Desktop.",
        "NSDocumentsFolderUsageDescription": "Konsey and its agents work on project folders you pick in Documents.",
        "NSDownloadsFolderUsageDescription": "Konsey and its agents work on project folders you pick in Downloads.",
        "NSRemovableVolumesUsageDescription": "Konsey and its agents work on project folders you pick on external drives.",
        "NSNetworkVolumesUsageDescription": "Konsey and its agents work on project folders you pick on network drives."
      }
    },
    "dmg": {
      "title": "Konsey",
      "artifactName": "Konsey-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Konsey-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Konsey",
      "artifactName": "Konsey-windows-${arch}-setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ardakie",
        "repo": "konsey",
        "releaseType": "release"
      }
    ],
    "afterPack": "scripts/adhoc-sign.js"
  },
  "author": {
    "name": "Arda",
    "url": "https://github.com/ardakie"
  },
  "homepage": "https://konsey.weis.ltd",
  "repository": {
    "type": "git",
    "url": "https://github.com/ardakie/konsey.git"
  },
  "license": "MIT"
}
